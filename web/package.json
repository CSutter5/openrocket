{
  "name": "openrocket-web-feasibility",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "engine-adapter", "platform-proof", "app"],
  "engines": {"node": ">=22.12"},
  "scripts": {
    "test": "npm run test:contracts && npm run check:fixtures && npm test --workspace @openrocket/ork-format && npm test --workspace @openrocket/platform-proof",
    "test:contracts": "npm test --workspace @openrocket/contracts",
    "check:fixtures": "python3 scripts/fixture-inventory.py --check",
    "dev:app": "npm run dev --workspace @openrocket/local-editor",
    "build:app": "npm run build --workspace @openrocket/local-editor",
    "test:app": "npm test --workspace @openrocket/local-editor",
    "prepare:cloudflare": "npm run build --workspace @openrocket/engine-proof && npm run check:cloudflare --workspace @openrocket/local-editor",
    "preview:cloudflare": "npm run preview:cloudflare --workspace @openrocket/local-editor",
    "test:coediting": "npm run test:coediting --workspace @openrocket/local-editor",
    "test:cloudflare": "npm run test:cloudflare --workspace @openrocket/local-editor",
    "test:accounts": "npm run test:accounts --workspace @openrocket/local-editor",
    "test:management": "npm run test:management --workspace @openrocket/local-editor",
    "test:account-settings": "npm run test:account-settings --workspace @openrocket/local-editor"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "miniflare": "5.20261117.0-beta",
    "playwright": "1.61.1"
  }
}
