{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "openrocket-browser-editor",
  "compatibility_date": "2026-11-17",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "main": "server/index.ts",
  "durable_objects": {
    "bindings": [
      {
        "name": "SHARED_ROCKET",
        "class_name": "SharedRocket"
      }
    ]
  },
  "migrations": [
    {
      "tag": "coedit-v1",
      "new_sqlite_classes": [
        "SharedRocket"
      ]
    }
  ],
  "observability": {
    "enabled": false
  }
}
