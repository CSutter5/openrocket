{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "openrocket-browser-editor",
  "compatibility_date": "2026-11-17",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "main": "server/index.ts",
  "durable_objects": {
    "bindings": [
      {
        "name": "SHARED_ROCKET",
        "class_name": "SharedRocket"
      }
    ]
  },
  "migrations": [
    {
      "tag": "coedit-v1",
      "new_sqlite_classes": [
        "SharedRocket"
      ]
    }
  ],
  "observability": {
    "enabled": false
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openrocket-accounts",
      "database_id": "89cb86bd-db35-4e83-95e2-1e59df10a751",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "AUTH_BASE_URL": "http://127.0.0.1:8787"
  },
  "secrets": {
    "required": [
      "AUTH_SECRET"
    ]
  }
}
