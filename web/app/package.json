{
  "name": "@openrocket/local-editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && tsc --project tsconfig.server.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "predev": "node scripts/check-engine.mjs && node scripts/generate-motors.mjs && node scripts/generate-components.mjs",
    "prebuild": "node scripts/check-engine.mjs && node scripts/generate-motors.mjs && node scripts/generate-components.mjs",
    "test": "npm run build && node --experimental-strip-types test/acceptance.mjs",
    "check:cloudflare": "npm run build && wrangler deploy --dry-run --outdir build/cloudflare",
    "preview:cloudflare": "node scripts/preview-cloudflare.mjs",
    "test:cloudflare": "npm run check:cloudflare && node test/cloudflare.mjs",
    "test:coediting": "npm run check:cloudflare && node test/coediting.mjs",
    "test:accounts": "npm run check:cloudflare && node test/accounts.mjs",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test:management": "npm run check:cloudflare && node test/management.mjs",
    "test:account-settings": "npm run check:cloudflare && node test/account-settings.mjs",
    "test:sharing": "npm run check:cloudflare && node test/sharing-migration.mjs && node test/sharing.mjs",
    "test:preferences": "npm run check:cloudflare && node test/preferences.mjs",
    "test:password-reset": "npm run check:cloudflare && node test/password-reset-migration.mjs && node test/password-reset.mjs",
    "test:archive-upload": "npm run check:cloudflare && node test/archive-upload.mjs"
  },
  "dependencies": {
    "@openrocket/contracts": "0.0.0",
    "saxes": "6.0.0",
    "@openrocket/ork-format": "0.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "better-auth": "1.7.25",
    "@better-auth/drizzle-adapter": "1.7.25",
    "drizzle-orm": "0.45.4"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "wrangler": "4.164.0",
    "@cloudflare/workers-types": "5.20261118.1"
  }
}
