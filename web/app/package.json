{
  "name": "@openrocket/local-editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && tsc --project tsconfig.server.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "predev": "node scripts/check-engine.mjs && node scripts/generate-motors.mjs && node scripts/generate-components.mjs",
    "prebuild": "node scripts/check-engine.mjs && node scripts/generate-motors.mjs && node scripts/generate-components.mjs",
    "test": "npm run build && node --experimental-strip-types test/acceptance.mjs",
    "check:cloudflare": "npm run build && wrangler deploy --dry-run --outdir build/cloudflare",
    "preview:cloudflare": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "test:cloudflare": "npm run check:cloudflare && node test/cloudflare.mjs",
    "test:coediting": "npm run check:cloudflare && node test/coediting.mjs"
  },
  "dependencies": {
    "@openrocket/contracts": "0.0.0",
    "saxes": "6.0.0",
    "@openrocket/ork-format": "0.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "wrangler": "4.164.0",
    "@cloudflare/workers-types": "5.20261118.1"
  }
}
